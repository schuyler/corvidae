# LLM backend — OpenAI-compatible Chat Completions API (required)
# llm.main is required. Every other key under llm: is an optional role
# (background, embedding, ...); any unconfigured role falls back to llm.main.
llm:
  main:
    base_url: http://localhost:8080/v1   # llama-server, vLLM, OpenAI, etc.
    model: llama3                     # model name as the backend expects it
    # api_key: sk-...                 # omit for local servers
    # extra_body:                      # optional: provider-specific request payload extensions
    #   id_slot: 0                      # example: llama.cpp KV cache slot for parallelism
    # max_retries: 3                   # max retry attempts on transient errors (429, 500, 502, 503, 504)
    # retry_base_delay: 2.0            # base delay in seconds for exponential backoff
    # retry_max_delay: 60.0            # maximum delay cap in seconds
    # model_not_loaded_wait: 60.0      # seconds to wait out "model is not loaded" (llama-server router)
    # timeout: null                    # HTTP timeout in seconds per request (null uses aiohttp's 300s default)
  # background:                        # optional: separate LLM for background tasks
  #   base_url: http://localhost:8080   # all fields must be specified; no inheritance from llm.main
  #   model: llama3
  #   # api_key: sk-...                 # omit for local servers
  #   # extra_body:
  #   #   id_slot: 1
  #   # max_retries: 3
  #   # retry_base_delay: 2.0
  #   # retry_max_delay: 60.0
  #   # model_not_loaded_wait: 60.0
  #   # timeout: null
  # embedding:                         # optional: embedding model for memory retrieval
  #   base_url: http://localhost:8082/v1  # embedding servers are usually separate endpoints
  #   model: nomic-embed-text
  #   dimensions: 768                  # REQUIRED: fixed vector dimension of the model
  #   # api_key: sk-...                # omit for local servers

# Daemon settings (optional)
daemon:
  session_db: sessions.db           # SQLite path for conversation history
  # max_task_workers: 4             # concurrent background task workers
  # completed_task_buffer: 100      # completed tasks retained in memory
  # idle_cooldown_seconds: 30       # minimum seconds between on_idle firings
  # idle_poll_interval: 2           # seconds between idle-state checks

# Agent-level defaults — apply to all channels unless overridden (optional)
agent:
  system_prompt: "You are a helpful assistant."
  max_context_tokens: 64000
  reasoning_history: drop         # drop | exchange | keep — reasoning_content kept in history.
                                  # exchange: keep it only for the current exchange (since the
                                  # last user message); pair with the server's preserve_thinking off.
  # max_turns: 10                   # max consecutive tool-calling turns per exchange (message or scheduled firing)
  # max_tool_result_chars: 100000   # truncate tool results beyond this length
  # compaction_threshold: 0.8       # compact when token estimate exceeds this × max_context_tokens
  # compaction_retention: 0.5       # after compaction, retain this fraction of token budget
  #                                    ⚠ Must be significantly less than compaction_threshold.
  #                                    If retention ≥ threshold, compaction is a no-op and the agent
  #                                    will re-compact every few messages without reducing context.
  # min_messages_to_compact: 5      # skip compaction with this many messages or fewer
  # compaction_prompt: "..."        # summarizer system prompt, used in every compaction round
  # compaction_fork_prompt: "..."   # instruction a compaction fork appends (prompts/compaction_fork.md)
  # forks:                          # run background stages as forks of the main window (#51)
  #   enabled: false                # opt-in; any fork failure falls back to the standalone call
  #   reasoning_budget_tokens: 2048 # per-fork think budget; null = server default
  #   stages: null                  # null = all; or [compaction, consolidation, appraisal, critique]
  # chars_per_token: 3.5            # deprecated: retained for config compatibility; has no effect on token counting
  # request_logprobs: false         # ask the LLM for token logprobs on every request (llama-server supports
  #                                    this; Anthropic-style providers ignore it and logprobs surface as null)
  # mid_conversation_system_role: system  # system | user. Role for system messages after the first
  #                                    (memory CONTEXT, notifications, scheduled firings). Set user for strict chat templates
  #                                    (Qwen 3.8, Swift-1.5) that reject a non-leading system message.
  # immutable_settings:             # keys the agent cannot change via set_settings (system_prompt always blocked)
  #   - max_turns                   # example: prevent the agent from extending its own turn limit
  #   # Block these everywhere: undotted keys are forwarded into the LLM
  #   # request body, and these override the conversation itself
  #   # (docs/threat-model.md, finding 1):
  #   - messages
  #   - model
  #   - tools
  #   - tool_choice
  #   # Recommended additions for multi-speaker channels with untrusted
  #   # participants (see docs/configuration.md "Runtime-tunable gate parameters"):
  #   # - critique.provenance.enabled
  #   # - critique.provenance.weak_score
  #   # - critique.provenance.max_terms
  #   # - critique.sample_below_rate
  #   # - critique.prompt.provenance     # the critic's own system prompts
  #   # - critique.prompt.adversarial
  #   # - critique.prompt.constrained
  #   # - critique.prompt.predictive
  #   # - appraisal.stage2_prompt

# Autobiographical memory (optional; see docs/configuration.md)
# memory:
#   half_life_days: 30                # retrieval recency decay (e-folding time, days)
#   retrieval:
#     band_on: score                  # score | similarity: what strong/moderate/weak is applied to
#     recency_from: created           # created | last_used: where ranking age is measured from
#   channel_groups:                   # channels in a group share memory; members may use * and ?
#     home: ["irc:#lex", "signal:*"]  # signal:* covers Signal channels created at runtime
#   consolidation_fork_prompt: "..."  # instruction for forked consolidation (agent.forks)

# Fork instructions for appraisal and critique (optional; agent.forks).
# Static config: set_settings can't change these.
# appraisal:
#   stage2_fork_prompt: "..."         # prompts/appraisal_fork.md
# critique:
#   fork_prompt:
#     provenance: "..."               # prompts/critique_<lens>_fork.md

# Built-in tool settings (optional)
# tools:
#   shell_timeout: 30               # seconds before shell command is killed
#   web_fetch_timeout: 15           # seconds before HTTP request is aborted
#   web_max_response_bytes: 50000   # max bytes of HTTP response body
#   max_file_read_bytes: 1048576    # max file size for read_file (1 MB)
#   disabled: []                    # tool names to drop entirely, e.g. [shell, task_pipeline, write_file]
#                                   # or [set_settings]; see docs/threat-model.md

# IRC transport connection settings (optional — omit to disable IRC)
# irc:
#   host: irc.libera.chat              # IRC server hostname
#   port: 6667                         # IRC server port
#   nick: sherman                      # bot nickname
#   tls: false                         # use TLS (set port to 6697 with tls: true)
#   message_chunk_size: 400            # max UTF-8 bytes per outbound message
#   channels:                          # channels to auto-join
#     - "#general"
#     - "#random"

# Signal transport connection settings (optional — omit to disable Signal;
# corvidae connects to an already-running signal-cli daemon, it does not
# spawn or supervise one — see docs/signal-ops.md for registration)
# signal:
#   socket: /run/corvidae/signal.sock  # signal-cli JSON-RPC daemon socket
#   account: "+15550001111"            # the bot's own number
#   allow:                             # ACIs or E.164; default-deny
#     - "+15551234567"
#   message_chunk_size: 2000           # max UTF-8 bytes per outbound message

# Scheduler: reminders (remind_me tool) and operator jobs (optional;
# without this block the tools still work, in UTC, with these defaults).
# A job can target any channel; see docs/threat-model.md finding 7.
# scheduler:
#   timezone: America/Los_Angeles      # resolves offset-less times; default UTC
#   catch_up_window: 3600              # seconds a reminder missed while down may still fire
#   max_reminders_per_channel: 50      # pending tool-created reminders per channel
#   jobs:                              # synced by name on start and reload
#     - name: heartbeat                # unique; removing it disables the job durably
#       channel: internal:heartbeat    # no transport owns it: replies go to the log only
#       origin: heartbeat              # reminder (default) | heartbeat
#       every: 6h                      # required: 30s, 20m, 6h, 1d, 7d, 1h30m
#       at: "08:00"                    # optional anchor: HH:MM, or ISO datetime for a weekday
#       prompt_file: prompts/heartbeat.md   # or prompt: "..."
#     - name: morning-checkin
#       channel: signal:8f2c1c9a-3e21-4b77-9c3f-1a2b3c4d5e6f
#       every: 1d
#       at: "08:30"
#       prompt: "Good-morning check-in: ask how they slept and what is on today."

# Logging (optional)
# logging:
#   level: INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
#   file: corvidae.log         # log to file; omit for stderr (CLI defaults to file)

# MCP servers (optional) — tools from external Model Context Protocol servers
# mcp:
#   servers:
#     fs:
#       transport: stdio                 # stdio | sse
#       command: npx
#       args: ["-y", "@modelcontextprotocol/server-filesystem", "/path"]
#       timeout_seconds: 30              # per tool call
#       connect_timeout_seconds: 30      # startup handshake; a server that misses it is skipped

# Per-channel config (optional)
# Keys must be "transport:scope". Overrides agent defaults where set.
channels:
  cli:local:
    system_prompt: "You are a helpful assistant running in CLI mode."
  # irc:#lex:
  #   system_prompt: "You are Sherman, an IRC bot in #lex."
  #   max_context_tokens: 8000
  # signal:8f2c1c9a-3e21-4b77-9c3f-1a2b3c4d5e6f:   # ACI-keyed form (signal:<aci>) is recommended
  #   system_prompt: "You are Sherman, a Signal DM bot."
